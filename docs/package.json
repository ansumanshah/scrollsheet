{
  "name": "scrollsheet-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run sync:static && bun run --bun astro dev --port 4321",
    "build": "bun run sync:static && bun run --bun astro build",
    "preview": "bun run --bun astro preview --port 4321",
    "typecheck": "bun run --bun astro check",
    "gen:og": "bun run scripts/gen-og.ts",
    "sync:static": "bun run scripts/sync-static.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/react": "^7.1.2",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.8",
    "astro": "^7.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^6.0.3"
  }
}
