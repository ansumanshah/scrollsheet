---
/**
 * Starlight `Header` override: the same site header as the rest of the
 * site (Base.astro's Header.astro), so /docs/* doesn't read as a
 * different product, plus Starlight's own <Search /> for Pagefind.
 */
import Search from "@astrojs/starlight/components/Search.astro";
import Logo from "../Logo.astro";
import ThemeToggle from "../ThemeToggle.astro";
import { isCurrentNav, nav } from "../../lib/site-nav";

const { pathname } = Astro.url;
---

<header class="site-header site-header--docs">
  <div class="container site-header__inner">
    <a class="brand" href="/" aria-label="scrollsheet home">
      <Logo />
      <span class="brand__word">scrollsheet</span>
    </a>

    <nav class="site-nav" aria-label="Primary">
      {
        nav.map((item) => (
          <a href={item.href} aria-current={isCurrentNav(pathname, item) ? "page" : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="site-actions">
      <Search />
      <ThemeToggle />

      <a
        class="site-nav-github"
        href="https://github.com/ansumanshah/scrollsheet"
        target="_blank"
        rel="noreferrer"
        aria-label="GitHub"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.385-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.84 1.238 1.84 1.238 1.07 1.834 2.807 1.304 3.492.997.108-.775.42-1.305.763-1.605-2.665-.303-5.467-1.334-5.467-5.93 0-1.31.468-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
          ></path>
        </svg>
        <span>GitHub</span>
      </a>
    </div>
  </div>
</header>
