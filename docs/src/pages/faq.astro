---
import Base from "../layouts/Base.astro";
import { BUNDLE_SIZES } from "../lib/bundle-sizes.generated";

const indexBrotli = BUNDLE_SIZES.index.brotliKb.toFixed(2);

interface FaqItem {
  id: string;
  question: string;
  answer: string;
}

const faqs: FaqItem[] = [
  {
    id: "why-not-vaul",
    question: "How does it differ from vaul?",
    answer: `Touch dragging is native scroll-snap and modal sheets are a <code>&lt;dialog&gt;</code>. The <code>Drawer</code> adapter takes common vaul props, including <code>snapPoints</code> and <code>direction</code>; portal containers and some focus callbacks are unsupported and warn in development. See the <a href="/docs/migrating/from-vaul">migration guide</a> and <a href="/compare/vaul">comparison</a>.`,
  },
  {
    id: "how-big",
    question: "What is the bundle size?",
    answer: `The <code>Sheet</code> import is ${indexBrotli} kB compressed (brotli), excluding React, CSS, and chunks loaded on demand. Many libraries quote gzip, which runs larger. There are no runtime dependencies.`,
  },
  {
    id: "app-router-rsc",
    question: "Does it work with Next.js App Router?",
    answer: `Yes. Add <code>'use client'</code> to the file that renders <code>Sheet.Root</code>. See <a href="/docs/advanced/framework-support">Framework support</a>.`,
  },
  {
    id: "tailwind",
    question: "Does it work with Tailwind?",
    answer: `Yes. Pass utilities through <code>className</code> and load the scrollsheet stylesheet. See <a href="/docs/styling/tailwind">Tailwind</a>.`,
  },
  {
    id: "accessibility",
    question: "How accessible is it?",
    answer: `Modal sheets use <code>showModal()</code> for focus containment, and a multi-detent <code>Sheet.Handle</code> is a keyboard slider. Supply a <code>Sheet.Title</code> or an accessible label. See <a href="/docs/accessibility">Accessibility</a>.`,
  },
  {
    id: "browser-support",
    question: "Which browsers does it support?",
    answer: `Browsers without <code>&lt;dialog&gt;</code> get a fixed-position modal with backdrop and Escape dismissal, but no detents or dragging. See the <a href="/docs/browser-support">support matrix</a>.`,
  },
  {
    id: "migrate-from-sonner",
    question: "Which Sonner APIs are supported?",
    answer: `Common ones, including <code>success</code>, <code>error</code>, <code>custom</code>, and <code>promise</code>. Dark and system theming, <code>richColors</code>, and RTL are not implemented. See <a href="/docs/migrating/from-sonner">Migrate from Sonner</a>.`,
  },
  {
    id: "snap-points",
    question: "Does it support snap points?",
    answer: `Yes. Pass <code>detents</code> an array of <code>'full'</code>, <code>'medium'</code>, <code>'content'</code>, a fraction, or a pixel string. See <a href="/docs/detents-and-control/detents">Detents</a>.`,
  },
  {
    id: "ios-keyboard",
    question: "Does it handle the iOS keyboard?",
    answer: `Yes. It tracks <code>visualViewport</code>, and bottom sheets move above the keyboard when a text field has focus. See <a href="/docs/scrolling-and-keyboard/keyboard">Keyboard</a>.`,
  },
  {
    id: "shadow-dom",
    question: "Does it work inside a Shadow DOM?",
    answer: `Controls can live in a shadow root, but <code>Sheet.Content</code> portals to <code>document.body</code>, so load its styles in the document. See <a href="/docs/advanced/shadow-dom">Shadow DOM</a>.`,
  },
  {
    id: "maintained",
    question: "Who maintains it?",
    answer: `Ansuman Shah, under the NoodleApps studio name. It is MIT-licensed. See the <a href="/changelog">changelog</a> and <a href="https://github.com/ansumanshah/scrollsheet" target="_blank" rel="noreferrer">GitHub</a>.`,
  },
];

const answerText = (html: string) =>
  html
    .replace(/<[^>]+>/g, "")
    .replaceAll("&lt;", "<")
    .replaceAll("&gt;", ">");

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: answerText(item.answer),
    },
  })),
};
---

<Base
  title="FAQ"
  description="Bundle sizes, browser support, styling, accessibility, and migration guides for scrollsheet."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="container docs-shell">
    <div class="docs-content">
      <nav class="docs-mobile-toc" aria-label="Jump to question">
        {faqs.map((item) => <a href={`#${item.id}`}>{item.question}</a>)}
      </nav>

      <div class="docs-header">
        <p class="eyebrow">FAQ</p>
        <h1>Frequently asked questions</h1>
        <p>Setup, browser support, styling, and migration.</p>
      </div>

      <div class="prose faq-list">
        {
          faqs.map((item) => (
            <section id={item.id} class="faq-item">
              <h2>{item.question}</h2>
              <p set:html={item.answer} />
            </section>
          ))
        }
      </div>
    </div>

    <aside class="docs-toc" aria-label="On this page">
      <p class="docs-sidebar-title">Questions</p>
      {faqs.map((item) => <a href={`#${item.id}`}>{item.question}</a>)}
    </aside>
  </div>
</Base>

<style>
  .faq-item h2 {
    font-size: 1.15rem;
  }
  .faq-item h2:first-child {
    margin-top: 0;
  }
</style>
