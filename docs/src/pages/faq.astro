---
import Base from "../layouts/Base.astro";
import { BUNDLE_SIZES } from "../lib/bundle-sizes.generated";

const indexGzip = BUNDLE_SIZES.index.gzipKb.toFixed(2);
const indexBrotli = BUNDLE_SIZES.index.brotliKb.toFixed(2);

interface FaqItem {
  id: string;
  question: string;
  answerHtml: string;
  answerText: string;
}

// Keep HTML answers and structured-data text consistent when updating a question.
const faqs: FaqItem[] = [
  {
    id: "why-not-vaul",
    question: "How does it differ from vaul?",
    answerHtml: `scrollsheet uses native scroll-snap for touch dragging and a <code>&lt;dialog&gt;</code> for modal sheets. The <code>Drawer</code> adapter supports common vaul APIs. Styling differs and some props are unsupported. Review <a href="/docs/migrating/from-vaul">the migration guide</a> before changing imports, or read the <a href="/compare/vaul">full comparison</a>.`,
    answerText: `scrollsheet uses native scroll-snap for touch dragging and a dialog for modal sheets. The Drawer adapter supports common vaul APIs. Styling differs and some props are unsupported. Review the migration guide before changing imports, or read the full comparison.`,
  },
  {
    id: "how-big",
    question: "What is the bundle size?",
    answerHtml: `The <code>Sheet</code> import is ${indexGzip} kB gzipped or ${indexBrotli} kB brotli after bundling and minification with Bun. These measurements exclude React, stylesheets, and feature chunks loaded on demand. There are no runtime dependencies; <code>react</code> and <code>react-dom</code> are peers, both <code>&gt;=18</code>. See <a href="/docs/getting-started/install">Install</a>.`,
    answerText: `The Sheet import is ${indexGzip} kB gzipped or ${indexBrotli} kB brotli after bundling and minification with Bun. These measurements exclude React, stylesheets, and feature chunks loaded on demand. There are no runtime dependencies; react and react-dom are peers, both 18 or newer.`,
  },
  {
    id: "app-router-rsc",
    question: "Does it work with Next.js App Router and React Server Components?",
    answerHtml: `Use <code>Sheet.*</code> inside a Client Component. Add <code>'use client'</code> to the file that renders <code>&lt;Sheet.Root&gt;</code>; keep namespace member access out of Server Components. The published JavaScript chunks include client directives. See <a href="/docs/advanced/framework-support">Framework support</a>.`,
    answerText: `Use Sheet.* inside a Client Component. Add use client to the file that renders Sheet.Root; keep namespace member access out of Server Components. The published JavaScript chunks include client directives.`,
  },
  {
    id: "tailwind",
    question: "Does it work with Tailwind?",
    answerHtml: `Pass Tailwind utilities through <code>className</code> and load the scrollsheet stylesheet. Visual defaults use low-specificity selectors. Layout and transform rules control how the sheet moves. See <a href="/docs/styling/tailwind">Tailwind</a> for setup and styling examples.`,
    answerText: `Pass Tailwind utilities through className and load the scrollsheet stylesheet. Visual defaults use low-specificity selectors. Layout and transform rules control how the sheet moves. See the Tailwind guide for setup and styling examples.`,
  },
  {
    id: "accessibility",
    question: "How accessible is it?",
    answerHtml: `Modal sheets use <code>showModal()</code> to keep focus inside the dialog. Supply a <code>Sheet.Title</code> or an accessible label. With multiple detents, <code>Sheet.Handle</code> acts as a slider: arrow keys move between stops, and Home/End select the first/last stop. The fallback without <code>&lt;dialog&gt;</code> does not provide the same native focus containment. See <a href="/docs/accessibility">Accessibility</a>.`,
    answerText: `Modal sheets use showModal to keep focus inside the dialog. Supply a Sheet.Title or an accessible label. With multiple detents, Sheet.Handle acts as a slider: arrow keys move between stops, and Home and End select the first and last stop. The fallback without dialog does not provide the same native focus containment.`,
  },
  {
    id: "browser-support",
    question: "Which browsers does it support?",
    answerHtml: `Modal sheets use <code>&lt;dialog&gt;</code>; touch dragging uses CSS scroll-snap. Without CSS <code>linear()</code>, animations use an ease-out curve. Without scroll-driven animations, JavaScript updates the backdrop. Browsers without <code>&lt;dialog&gt;</code> get a fixed-position fallback with backdrop and Escape dismissal, but no detents or dragging. See the <a href="/docs/browser-support">browser support matrix</a> for version requirements.`,
    answerText: `Modal sheets use dialog; touch dragging uses CSS scroll-snap. Without CSS linear easing, animations use an ease-out curve. Without scroll-driven animations, JavaScript updates the backdrop. Browsers without dialog get a fixed-position fallback with backdrop and Escape dismissal, but no detents or dragging.`,
  },
  {
    id: "migrate-from-vaul",
    question: "Which vaul APIs are supported?",
    answerHtml: `The <code>Drawer</code> export supports common vaul APIs, including <code>snapPoints</code>, <code>direction</code>, <code>modal</code>, and <code>shouldScaleBackground</code>. Portal containers and some focus and outside-interaction callbacks are unsupported and warn in development. Styling and dismissal behavior can differ. See <a href="/docs/migrating/from-vaul">Migrate from vaul</a> for the prop mapping.`,
    answerText: `The Drawer export supports common vaul APIs, including snapPoints, direction, modal, and shouldScaleBackground. Portal containers and some focus and outside-interaction callbacks are unsupported and warn in development. Styling and dismissal behavior can differ. See the vaul migration guide for the prop mapping.`,
  },
  {
    id: "migrate-from-sonner",
    question: "Which Sonner APIs are supported?",
    answerHtml: `The <code>toast</code> and <code>Toaster</code> exports support common Sonner APIs, including <code>success</code>, <code>error</code>, <code>custom</code>, <code>promise</code>, and scoped toast queues. <code>useToasts</code> is an alias for <code>useSonner</code>. Compatibility class names preserve many existing selectors, but markup and styling can differ. Dark/system theming, <code>richColors</code>, and RTL configuration are not implemented. See <a href="/docs/migrating/from-sonner">Migrate from Sonner</a>.`,
    answerText: `The toast and Toaster exports support common Sonner APIs, including success, error, custom, promise, and scoped toast queues. useToasts is an alias for useSonner. Compatibility class names preserve many existing selectors, but markup and styling can differ. Dark and system theming, richColors, and RTL configuration are not implemented.`,
  },
  {
    id: "snap-points",
    question: "Does it support snap points?",
    answerHtml: `Pass an array to <code>detents</code>. Values can be <code>'full'</code>, <code>'medium'</code>, <code>'content'</code> for natural height, a fraction in <code>(0, 1]</code>, or a pixel string such as <code>'320px'</code>. Numbers above 1 are also treated as pixels. See <a href="/docs/detents-and-control/detents">Detents</a>.`,
    answerText: `Pass an array to detents. Values can be full, medium, content for natural height, a fraction above zero through one, or a pixel string such as 320px. Numbers above one are also treated as pixels.`,
  },
  {
    id: "ios-keyboard",
    question: "Does it handle the iOS keyboard?",
    answerHtml: `scrollsheet tracks <code>visualViewport</code> changes and updates <code>--scrollsheet-keyboard</code> when a text field has focus. Bottom sheets use that inset to move above the keyboard; other sheet positions add space for the keyboard. On iOS, modal sheets can temporarily freeze the body and restore its scroll position on close. See <a href="/docs/scrolling-and-keyboard/keyboard">Keyboard</a>.`,
    answerText: `scrollsheet tracks visualViewport changes and updates its keyboard inset when a text field has focus. Bottom sheets use that inset to move above the keyboard; other sheet positions add space for the keyboard. On iOS, modal sheets can temporarily freeze the body and restore its scroll position on close.`,
  },
  {
    id: "shadow-dom",
    question: "Does it work inside a Shadow DOM?",
    answerHtml: `You can mount sheet controls inside a shadow root, but <code>Sheet.Content</code> portals to <code>document.body</code>. Load the panel's styles in the document. The <code>scrollsheet/auto</code> entry embeds those styles; <code>injectStylesInto(shadowRoot)</code> is available for scrollsheet elements that remain inside the shadow root. It does not change the portal destination. See <a href="/docs/advanced/shadow-dom">Shadow DOM</a>.`,
    answerText: `You can mount sheet controls inside a shadow root, but Sheet.Content portals to document.body. Load the panel's styles in the document. The auto entry embeds those styles; injectStylesInto is available for scrollsheet elements that remain inside the shadow root. It does not change the portal destination.`,
  },
  {
    id: "maintained",
    question: "Who maintains it?",
    answerHtml: `Ansuman Shah maintains scrollsheet under the NoodleApps studio name. It is MIT-licensed and published on npm as <code>scrollsheet</code>. See the <a href="/changelog">changelog</a> for release notes and <a href="https://github.com/ansumanshah/scrollsheet" target="_blank" rel="noreferrer">GitHub</a> for source and issues.`,
    answerText: `Ansuman Shah maintains scrollsheet under the NoodleApps studio name. It is MIT-licensed and published on npm as scrollsheet. The changelog has release notes; GitHub hosts source and issues.`,
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answerText,
    },
  })),
};
---

<Base
  title="FAQ"
  description="Bundle sizes, browser support, styling, accessibility, and migration guides for scrollsheet."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="container docs-shell">
    <div class="docs-content">
      <nav class="docs-mobile-toc" aria-label="Jump to question">
        {faqs.map((item) => <a href={`#${item.id}`}>{item.question}</a>)}
      </nav>

      <div class="docs-header">
        <p class="eyebrow">FAQ</p>
        <h1>Frequently asked questions</h1>
        <p>Setup, browser support, styling, and migration.</p>
      </div>

      <div class="prose faq-list">
        {
          faqs.map((item) => (
            <section id={item.id} class="faq-item">
              <h2>{item.question}</h2>
              <p set:html={item.answerHtml} />
            </section>
          ))
        }
      </div>
    </div>

    <aside class="docs-toc" aria-label="On this page">
      <p class="docs-sidebar-title">Questions</p>
      {faqs.map((item) => <a href={`#${item.id}`}>{item.question}</a>)}
    </aside>
  </div>
</Base>

<style>
  .faq-item h2 {
    font-size: 1.15rem;
  }
  .faq-item h2:first-child {
    margin-top: 0;
  }
</style>
