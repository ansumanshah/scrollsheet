---
import Base from "../layouts/Base.astro";
import ExampleCard from "../components/ExampleCard.astro";
import ExamplePreview from "../components/ExamplePreview";
import HeroShowcase from "../components/HeroShowcase";
import InstallBox from "../components/InstallBox.astro";
import MigrationDiff from "../components/MigrationDiff.astro";
import LaunchVideo from "../components/LaunchVideo.astro";
import JsonLd from "../components/JsonLd.astro";
import { softwareSourceCode } from "../lib/jsonld";

import { examples, exampleGroups } from "../../../examples/index";
import "../../../examples/examples.css";
import { BUNDLE_SIZES, STYLESHEET_SIZES } from "../lib/bundle-sizes.generated";

// Raw text for the example gallery's "Styles" tab: the exact, unmodified
// shared stylesheet and icon set every example imports, so copying it
// alongside a card's Code tab is enough to run that example standalone.
import examplesCssRaw from "../../../examples/examples.css?raw";
import iconsRaw from "../../../examples/icons.tsx?raw";
import { scopeCssToExample, scopeIconsToExample } from "../lib/scope-css";

import mapsCode from "../../../examples/maps.tsx?raw";
import cartCode from "../../../examples/cart.tsx?raw";
import profileFormCode from "../../../examples/profile-form.tsx?raw";
import toastCode from "../../../examples/toast.tsx?raw";
import lightboxCode from "../../../examples/lightbox.tsx?raw";
import walletCode from "../../../examples/wallet.tsx?raw";
import sidesCode from "../../../examples/sides.tsx?raw";
import snapHeightsCode from "../../../examples/snap-heights.tsx?raw";
import confirmCode from "../../../examples/confirm.tsx?raw";
import nestedCode from "../../../examples/nested.tsx?raw";

const CODE: Record<string, string> = {
  maps: mapsCode,
  cart: cartCode,
  "profile-form": profileFormCode,
  toast: toastCode,
  lightbox: lightboxCode,
  wallet: walletCode,
  sides: sidesCode,
  "snap-heights": snapHeightsCode,
  confirm: confirmCode,
  nested: nestedCode,
};

/*
 * The homepage shows a curated slice, not the full registry: enough
 * distinct capabilities to scan in one screen without scrolling through
 * near-duplicates. Everything cut here still lives in examples/, still
 * ships with its own DocExample demo on the docs page that covers the
 * prop it exercises (see which-example-shows-which-prop.mdx), and is
 * still importable on its own — only this grid got smaller.
 */
const HOMEPAGE_EXAMPLES = [
  "maps",
  "wallet",
  "lightbox",
  "cart",
  "toast",
  "nested",
  "snap-heights",
  "profile-form",
  "sides",
  "confirm",
];

const homepageExamples = HOMEPAGE_EXAMPLES.map((name) => {
  const entry = examples.find((e) => e.name === name);
  if (!entry) throw new Error(`Homepage: no example named "${name}" in examples/index.ts`);
  return entry;
});

/*
 * The Styles tab used to ship all of examples.css (37 kB) and all of
 * icons.tsx on every card, so copying a 40-line component handed you a
 * thousand lines of CSS for two dozen unrelated examples. Scoped per example
 * instead: only the rules and glyphs that example actually references.
 */
const SCOPED: Record<string, { css: string; icons: string }> = Object.fromEntries(
  Object.entries(CODE).map(([name, source]) => [
    name,
    {
      css: scopeCssToExample(examplesCssRaw, source),
      icons: scopeIconsToExample(iconsRaw, source),
    },
  ]),
);

/*
 * Version floors match the Browser support section in docs.mdx, which is the
 * source of truth for them; the dates are the caniuse release dates for those
 * exact versions. Every card carries the same four things in the same order,
 * so they can be read down the column: what the sheet uses it for, when it
 * became available, which versions, and what happens without it. That last
 * line is the one a reader is actually deciding on.
 */
const PLATFORM = [
  {
    name: "<dialog>, top layer",
    use: "Stacks above page content",
    since: "Every engine, Mar 2022",
    versions: "Chrome 37, Safari 15.4, Firefox 98",
    without: "Fixed-position fallback, without dragging.",
  },
  {
    name: "CSS scroll-snap",
    use: "Touch dragging and snap stops",
    since: "Every engine, Jul 2019",
    versions: "Chrome 69, Safari 11, Firefox 68",
    without: "Dragging requires CSS scroll-snap.",
  },
  {
    name: "linear() easing",
    use: "Spring easing",
    since: "Every engine, Dec 2023",
    versions: "Chrome 113, Safari 17.2, Firefox 112",
    without: "Ease-out, same duration.",
  },
  {
    name: "Scroll-driven animations",
    use: "Backdrop opacity follows scroll",
    since: "Chrome Jul 2023, Safari Sep 2025",
    versions: "Chrome 115+, Safari 26+; feature-detected",
    without: "JavaScript updates opacity each frame.",
  },
  {
    name: "dialog.closedBy",
    use: "Browser handles close requests",
    since: "Chrome Mar 2025, Firefox Jul 2025",
    versions: "Chrome 134+, Firefox 141+; feature-detected",
    without: "JavaScript handles Escape and backdrop dismissal.",
  },
  {
    name: "CloseWatcher",
    use: "Android back button on non-modal sheets",
    since: "Chrome Jun 2024, Firefox Mar 2026",
    versions: "Chrome 126+, Firefox 149+; feature-detected",
    without: "Non-modal sheets ignore the back gesture.",
  },
];


// Import shapes are measured separately because unused exports can be removed.
const COMPARE_LIBS = ["Sheet", "Drawer", "Dialog", "Toaster + toast"];
const COMPARE_ROWS: {
  label: string;
  values: string[];
  best?: number;
  win?: number[];
  note?: string;
}[] = [
  {
    label: "Use",
    values: ["Sheets and side panels", "vaul migration", "Radix Dialog migration", "Notifications"],
  },
  {
    label: "Initial JavaScript, gzip",
    values: [
      `${BUNDLE_SIZES.index.gzipKb.toFixed(2)} kB`,
      `${BUNDLE_SIZES.drawer.gzipKb.toFixed(2)} kB`,
      `${BUNDLE_SIZES.dialog.gzipKb.toFixed(2)} kB`,
      `${BUNDLE_SIZES.toast.gzipKb.toFixed(2)} kB`,
    ],
    note: "Measured with Bun after minification, with React excluded. Includes static imports; excludes CSS and feature chunks loaded on demand.",
  },
  {
    label: "Position",
    values: ["Four edges or center", "Four edges", "Center", "Six stack positions"],
  },
  {
    label: "Dragging",
    values: ["yes", "yes", "no", "Swipe to dismiss"],
  },
  {
    label: "Modal behavior",
    values: ["Configurable", "Configurable", "Configurable", "no"],
  },
  {
    label: "Stylesheet, gzip",
    values: [
      `${STYLESHEET_SIZES.core.gzipKb.toFixed(2)} kB`,
      `${STYLESHEET_SIZES.core.gzipKb.toFixed(2)} kB`,
      `${STYLESHEET_SIZES.core.gzipKb.toFixed(2)} kB`,
      `${STYLESHEET_SIZES.toast.gzipKb.toFixed(2)} kB`,
    ],
    note: "Import scrollsheet/styles.css for sheets and scrollsheet/toast.css for toasts, or use scrollsheet/auto to embed the stylesheets.",
  },
  {
    label: "State",
    values: ["open / onOpenChange", "open / onOpenChange", "open / onOpenChange", "toast() / toast.dismiss()"],
  },
  {
    label: "API compatibility",
    values: ["Native scrollsheet API", "Common vaul APIs", "Common Radix Dialog APIs", "Common Sonner APIs"],
    note: "Adapters support common APIs. Styling differs and some props are unsupported. Check the migration guides before switching.",
  },
  {
    label: "React",
    values: ["18+", "18+", "18+", "18+"],
  },
  {
    label: "Runtime dependencies",
    values: ["0", "0", "0", "0"],
    note: "React and React DOM are peer dependencies and are excluded from these size measurements.",
  },
];

/* Notes render as numbered footnotes below the table, not inside label
 * cells: inline notes made row heights wildly uneven and broke the scan. */
const footnotes = COMPARE_ROWS.filter((r) => r.note).map((r) => r.note!);
const noteNumber = (note?: string) => (note ? footnotes.indexOf(note) + 1 : 0);

/* Plain yes/no cells become glyphs so wins and gaps scan at a glance;
 * nuanced values keep their text. */
const cellParts = (value: string) => {
  if (value === "yes") return { glyph: "✓", rest: "", cls: "is-yes" };
  if (value === "no") return { glyph: "", rest: "No", cls: "is-no" };
  if (value.startsWith("yes, ")) return { glyph: "✓", rest: value.slice(5), cls: "is-yes" };
  return { glyph: "", rest: value, cls: "" };
};

const title = "scrollsheet: native bottom sheets and drawers for React";
const description = `React bottom sheets, drawers, dialogs, side panels, and toast notifications. Native dialog and scroll-snap for sheets; ${Math.round(BUNDLE_SIZES.index.gzipKb)} kB gzipped for the Sheet import, excluding CSS and lazy chunks.`;
---

<Base title={title} description={description}>
  <Fragment slot="head">
    <JsonLd data={softwareSourceCode()} />
  </Fragment>
  <section class="container hero">
    <div class="hero-copy">
      <h1>Drop-in bottom sheets for React</h1>
      <p class="hero-lede">
        Detents, nested sheets, side panels and toasts in {Math.round(BUNDLE_SIZES.index.gzipKb)}&nbsp;kB
        gzipped, with no dependencies. Drawer accepts common vaul props.
      </p>
      <div class="hero-actions">
        <InstallBox />
      </div>
      <div class="hero-migrate">
        <MigrationDiff compact />
      </div>
    </div>

    <div class="hero-stage">
      <div class="phone-frame" id="hero-phone-frame">
        <div class="phone-frame-notch"></div>
        <iframe
          class="phone-frame-iframe"
          title="Live scrollsheet demo"
          src="about:blank"
          data-src="/embed/hero"
          loading="lazy"
        ></iframe>
      </div>
      {/*
        Below 980px there's no room for the phone frame beside the copy, and
        drawing a phone frame around a visitor's actual phone is absurd
        anyway — their own screen is the device. Same component as the
        frame's iframe, mounted directly with no frame and no iframe chrome,
        so the sheets it opens are real, full-size, and drawn against the
        real viewport instead of a boxed-in preview. client:visible so it
        never ships to the desktop visitor who gets the phone frame instead.
      */}
      <div class="hero-inline-demo">
        <HeroShowcase client:visible bottomSheetDetents={[0.5, "full"]} />
      </div>
    </div>
  </section>

  <script>
    // The phone frame only makes sense once there's room for it beside the
    // copy (matches the .hero two-column breakpoint in home.css). Below
    // that, .hero-inline-demo takes over via CSS and this never fires, so
    // the iframe's own bundle and the library it loads never ship to a
    // visitor who already has a real phone to try the gesture on.
    const frame = document.getElementById("hero-phone-frame");
    const iframe = frame?.querySelector<HTMLIFrameElement>(".phone-frame-iframe");
    const mql = window.matchMedia("(min-width: 980px)");
    const sync = () => {
      if (!iframe) return;
      if (mql.matches && iframe.src === "about:blank") {
        const src = iframe.dataset.src;
        if (src) iframe.src = src;
      }
    };
    sync();
    mql.addEventListener("change", sync);
  </script>

  <LaunchVideo />

  <section class="container section" aria-labelledby="alternatives-heading">
    <div class="section-head">
      <h2 id="alternatives-heading">Compared with the alternatives</h2>
    </div>
    <ul class="seo__links">
      <li>
        <a href="/compare/vaul">
          <strong>vs vaul</strong>
          <span>A two-line import swap, and the vaul options Drawer ignores.</span>
        </a>
      </li>
      <li>
        <a href="/compare/react-modal-sheet">
          <strong>vs react-modal-sheet</strong>
          <span>The Motion dependency, bundle size, and who handles focus.</span>
        </a>
      </li>
      <li>
        <a href="/compare/radix-dialog">
          <strong>vs Radix Dialog</strong>
          <span>Native dialog against a JavaScript focus scope, and when to keep Radix.</span>
        </a>
      </li>
      <li>
        <a href="/react-bottom-sheet">
          <strong>React bottom sheets</strong>
          <span>What a phone-ready sheet needs, with demos.</span>
        </a>
      </li>
    </ul>
  </section>

  <section class="container section" aria-labelledby="compare-heading">
    <div class="section-head">
      <h2 id="compare-heading">Choose an API</h2>
      <p>
        Use Sheet directly, or review the adapters for{" "}
        <a href="/docs/migrating/from-vaul">vaul</a>,{" "}
        <a href="/docs/migrating/from-radix-dialog">Radix Dialog</a>, and{" "}
        <a href="/docs/migrating/from-sonner">Sonner</a>.
      </p>
    </div>
    <div class="compare-scroll">
      <table class="compare-table">
        <thead>
          <tr>
            <th scope="col"><span class="visually-hidden">Dimension</span></th>
            {COMPARE_LIBS.map((lib, i) => (
              <th scope="col" class={i === 0 ? "compare-col-us" : undefined}>{lib}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {COMPARE_ROWS.map((row) => (
            <tr>
              <th scope="row">
                {row.label}
                {row.note && <sup class="compare-ref">{noteNumber(row.note)}</sup>}
              </th>
              {row.values.map((value, i) => {
                const part = cellParts(value);
                return (
                  <td
                    data-lib={COMPARE_LIBS[i]}
                    class={[
                      i === 0 ? "compare-col-us" : "",
                      row.best === i ? "is-best" : "",
                      row.win?.includes(i) ? "is-win" : "",
                      part.cls,
                    ].filter(Boolean).join(" ") || undefined}
                  >
                    <span class="cmp-val">
                      {part.glyph && <span class="cmp-glyph" aria-hidden="true">{part.glyph}</span>}
                      {part.glyph && (
                        <span class="visually-hidden">{part.glyph === "✓" ? "yes" : "no"}</span>
                      )}
                      {part.rest}
                    </span>
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {footnotes.length > 0 && (
      <ol class="compare-footnotes">
        {footnotes.map((note) => (
          <li>{note}</li>
        ))}
      </ol>
    )}
  </section>

  <section class="container section" aria-labelledby="platform-heading">
    <div class="section-head">
      <h2 id="platform-heading">Browser features</h2>
      <p>Sheets use native dialog and scroll-snap. JavaScript handles the gaps in browser support.</p>
    </div>
    <ul class="platform-grid">
      {
        PLATFORM.map((item) => (
          <li class="platform-card">
            <code>{item.name}</code>
            <p class="platform-card__use">{item.use}</p>
            <p class="platform-card__since">{item.since}</p>
            <p class="platform-card__versions">{item.versions}</p>
            <p class="platform-card__without">
              <span>Without it</span>
              {item.without}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="container section" id="examples" aria-labelledby="examples-heading">
    <div class="section-head">
      <h2 id="examples-heading">Examples</h2>
      <p>
        Try an example, then open Code to copy the source and styles.
        More examples are linked from the guides.
      </p>
    </div>

    <div class="examples-grid">
      {
        homepageExamples.map((entry) => {
          const group = exampleGroups.find((g) => g.id === entry.group);
          return (
            <ExampleCard
              slug={entry.name}
              title={entry.title}
              description={entry.description}
              groupTitle={group?.title ?? ""}
              code={CODE[entry.name] ?? ""}
              examplesCss={SCOPED[entry.name]?.css ?? ""}
              iconsCode={SCOPED[entry.name]?.icons ?? ""}
            >
              <ExamplePreview name={entry.name} client:visible />
            </ExampleCard>
          );
        })
      }
    </div>
  </section>

</Base>
