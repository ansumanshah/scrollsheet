{
  "name": "scrollsheet-repo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "scripts": {
    "build": "bun run scripts/gen-css.ts && bun run scripts/build.ts && bun run scripts/emit-css.ts && cp README.md LICENSE packages/scrollsheet/",
    "test": "bun test tests/unit",
    "test:e2e": "bun run --bun playwright test",
    "typecheck": "bun check",
    "dev": "bun run --cwd docs dev",
    "test:e2e:fast": "bun run --bun playwright test --project=chromium-mobile",
    "test:site": "bun run --bun playwright test -c playwright.site.config.ts",
    "verify": "bun run typecheck && bun run check:compat && bun run build && bun test tests/unit && bun run test:e2e:fast && bun run size && bun run pack:check && bun run check:registry",
    "gen:css": "bun run scripts/gen-css.ts",
    "size": "bun run scripts/check-size.ts",
    "pack:check": "bun run scripts/check-pack.ts",
    "check:registry": "bun run scripts/check-registry.ts",
    "check:dialog-share": "bun run scripts/check-dialog-share.ts",
    "check:compat": "bun run scripts/check-compat.ts"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "browserslist": "^4.29.5",
    "bun-plugin-dts": "^0.4.0",
    "doiuse": "^6.0.6",
    "lightningcss": "^1.33.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3"
  }
}
