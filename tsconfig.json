{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "declaration": true,
    "noEmit": true,
    "types": ["bun"],
    "paths": {
      "scrollsheet": ["./packages/scrollsheet/src/index.ts"],
      "scrollsheet/motion": ["./packages/scrollsheet/src/motion/index.ts"]
    }
  },
  "include": ["packages/scrollsheet/src", "registry/src", "tests", "scripts", "*.config.ts"]
}
